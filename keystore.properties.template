# Copy this file to "keystore.properties" (which is git-ignored) and fill in your values.
# Create an upload keystore first, e.g.:
#   keytool -genkey -v -keystore cooly-upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias cooly
#
# storeFile is resolved relative to the project root.
storeFile=cooly-upload.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=cooly
keyPassword=YOUR_KEY_PASSWORD
